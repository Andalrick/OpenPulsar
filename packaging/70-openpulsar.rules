# OpenPulsar — supported Pulsar wired gaming mice
# Grant the active local session access to both the USB device used by
# PyUSB/libusb and the matching hidraw interfaces.

# Direct USB access (PyUSB/libusb)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3710", ATTR{idProduct}=="1401", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3710", ATTR{idProduct}=="1402", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3710", ATTR{idProduct}=="1403", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3710", ATTR{idProduct}=="1404", TAG+="uaccess"

# hidraw access
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3710", ATTRS{idProduct}=="1401", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3710", ATTRS{idProduct}=="1402", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3710", ATTRS{idProduct}=="1403", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3710", ATTRS{idProduct}=="1404", TAG+="uaccess"
